
-- =========================================================================
-- TRABALHE+ : BANCO DE DADOS DO APLICATIVO
-- Contexto: Marketplace de profissionais e serviços
-- Normalização: 1FN, 2FN e 3FN
-- =========================================================================

DROP DATABASE IF EXISTS TrabalheMaisDB;

CREATE DATABASE TrabalheMaisDB;

USE TrabalheMaisDB;


-- =========================================================================
-- 1. TABELA USUARIO
-- Cadastro de clientes e profissionais
-- =========================================================================

CREATE TABLE Usuario (
    idUsuario INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

    nome VARCHAR(125) NOT NULL,

    telefone VARCHAR(20) NOT NULL UNIQUE,

    senha VARCHAR(255) NOT NULL,

    tipoUsuario ENUM('CLIENTE', 'PROFISSIONAL')
        NOT NULL,

    dataCadastro DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);


-- =========================================================================
-- 2. TABELA ENDERECO
-- 1FN: Endereço separado em atributos atômicos
-- Um usuário pode possuir vários endereços
-- =========================================================================

CREATE TABLE Endereco (
    idEndereco INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

    idUsuario INT UNSIGNED NOT NULL,

    logradouro VARCHAR(150) NOT NULL,

    numero VARCHAR(10) NOT NULL,

    bairro VARCHAR(60) NOT NULL,

    cidade VARCHAR(60) NOT NULL,

    uf CHAR(2) NOT NULL,

    cep CHAR(8) NOT NULL,

    CONSTRAINT fk_endereco_usuario
        FOREIGN KEY (idUsuario)
        REFERENCES Usuario(idUsuario)
        ON DELETE CASCADE
);


-- =========================================================================
-- 3. TABELA PROFISSAO
-- Cadastro das categorias profissionais
-- =========================================================================

CREATE TABLE Profissao (
    idProfissao INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

    nomeProfissao VARCHAR(100) NOT NULL UNIQUE,

    descricao VARCHAR(255)
);


-- =========================================================================
-- 4. TABELA PROFISSIONAL
-- Dados específicos de quem presta serviços
-- =========================================================================

CREATE TABLE Profissional (
    idProfissional INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

    idUsuario INT UNSIGNED NOT NULL UNIQUE,

    idProfissao INT UNSIGNED NOT NULL,

    descricao VARCHAR(500),

    experienciaAnos INT UNSIGNED NOT NULL DEFAULT 0,

    CONSTRAINT fk_profissional_usuario
        FOREIGN KEY (idUsuario)
        REFERENCES Usuario(idUsuario),

    CONSTRAINT fk_profissional_profissao
        FOREIGN KEY (idProfissao)
        REFERENCES Profissao(idProfissao)
);


-- =========================================================================
-- 5. TABELA SERVICO
-- Serviços oferecidos pelos profissionais
-- =========================================================================

CREATE TABLE Servico (
    idServico INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

    idProfissional INT UNSIGNED NOT NULL,

    nomeServico VARCHAR(100) NOT NULL,

    descricao VARCHAR(500),

    precoBase DECIMAL(10,2) NOT NULL,

    CONSTRAINT fk_servico_profissional
        FOREIGN KEY (idProfissional)
        REFERENCES Profissional(idProfissional)
);


-- =========================================================================
-- 6. TABELA SOLICITACAO
-- Cliente solicita um serviço
-- =========================================================================

CREATE TABLE Solicitacao (
    idSolicitacao INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

    idCliente INT UNSIGNED NOT NULL,

    idServico INT UNSIGNED NOT NULL,

    idEndereco INT UNSIGNED NOT NULL,

    dataSolicitacao DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    dataAgendada DATETIME,

    statusSolicitacao ENUM(
        'PENDENTE',
        'ACEITA',
        'EM_ANDAMENTO',
        'CONCLUIDA',
        'CANCELADA'
    ) NOT NULL DEFAULT 'PENDENTE',

    valorAcordado DECIMAL(10,2) NOT NULL,

    CONSTRAINT fk_solicitacao_cliente
        FOREIGN KEY (idCliente)
        REFERENCES Usuario(idUsuario),

    CONSTRAINT fk_solicitacao_servico
        FOREIGN KEY (idServico)
        REFERENCES Servico(idServico),

    CONSTRAINT fk_solicitacao_endereco
        FOREIGN KEY (idEndereco)
        REFERENCES Endereco(idEndereco)
);


-- =========================================================================
-- 7. TABELA PAGAMENTO
-- Pagamentos associados a uma solicitação
-- =========================================================================

CREATE TABLE Pagamento (
    idPagamento INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

    idSolicitacao INT UNSIGNED NOT NULL,

    valor DECIMAL(10,2) NOT NULL,

    formaPagamento ENUM(
        'PIX',
        'DINHEIRO',
        'CARTAO'
    ) NOT NULL,

    statusPagamento ENUM(
        'PENDENTE',
        'APROVADO',
        'RECUSADO',
        'ESTORNADO'
    ) NOT NULL DEFAULT 'PENDENTE',

    dataPagamento DATETIME,

    CONSTRAINT fk_pagamento_solicitacao
        FOREIGN KEY (idSolicitacao)
        REFERENCES Solicitacao(idSolicitacao)
);


-- =========================================================================
-- 8. TABELA AVALIACAO
-- Cliente avalia o profissional
-- =========================================================================

CREATE TABLE Avaliacao (
    idAvaliacao INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

    idSolicitacao INT UNSIGNED NOT NULL UNIQUE,

    nota TINYINT UNSIGNED NOT NULL,

    comentario VARCHAR(500),

    dataAvaliacao DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_avaliacao_solicitacao
        FOREIGN KEY (idSolicitacao)
        REFERENCES Solicitacao(idSolicitacao),

    CONSTRAINT chk_nota
        CHECK (nota BETWEEN 1 AND 5)
);



-- =========================================================================
-- 10. CONSULTAS DO SISTEMA
-- =========================================================================


-- CONSULTA 1:
-- Listar profissionais e suas profissões

SELECT
    u.nome AS profissional,
    p.nomeProfissao AS profissao,
    pr.experienciaAnos AS experiencia,
    pr.descricao AS descricao
FROM Profissional pr

INNER JOIN Usuario u
    ON pr.idUsuario = u.idUsuario

INNER JOIN Profissao p
    ON pr.idProfissao = p.idProfissao;


-- CONSULTA 2:
-- Listar serviços disponíveis

SELECT
    s.idServico,
    s.nomeServico AS servico,
    p.nomeProfissao AS profissao,
    u.nome AS profissional,
    s.precoBase AS preco
FROM Servico s

INNER JOIN Profissional pr
    ON s.idProfissional = pr.idProfissional

INNER JOIN Usuario u
    ON pr.idUsuario = u.idUsuario

INNER JOIN Profissao p
    ON pr.idProfissao = p.idProfissao;


-- CONSULTA 3:
-- Mostrar solicitações dos clientes

SELECT
    so.idSolicitacao,
    cliente.nome AS cliente,
    profissional.nome AS profissional,
    serv.nomeServico AS servico,
    so.dataAgendada AS agendamento,
    so.statusSolicitacao AS status,
    so.valorAcordado AS valor
FROM Solicitacao so

INNER JOIN Usuario cliente
    ON so.idCliente = cliente.idUsuario

INNER JOIN Servico serv
    ON so.idServico = serv.idServico

INNER JOIN Profissional pr
    ON serv.idProfissional = pr.idProfissional

INNER JOIN Usuario profissional
    ON pr.idUsuario = profissional.idUsuario

ORDER BY so.dataSolicitacao DESC;


-- CONSULTA 4:
-- Total de serviços concluídos por profissional

SELECT
    u.nome AS profissional,

    COUNT(so.idSolicitacao) AS totalServicos,

    SUM(so.valorAcordado) AS faturamentoBruto

FROM Profissional pr

INNER JOIN Usuario u
    ON pr.idUsuario = u.idUsuario

INNER JOIN Servico s
    ON pr.idProfissional = s.idProfissional

INNER JOIN Solicitacao so
    ON s.idServico = so.idServico

WHERE so.statusSolicitacao = 'CONCLUIDA'

GROUP BY pr.idProfissional, u.nome;


-- CONSULTA 5:
-- Média das avaliações dos profissionais

SELECT
    u.nome AS profissional,

    ROUND(AVG(a.nota), 2) AS mediaAvaliacao,

    COUNT(a.idAvaliacao) AS totalAvaliacoes

FROM Profissional pr

INNER JOIN Usuario u
    ON pr.idUsuario = u.idUsuario

INNER JOIN Servico s
    ON pr.idProfissional = s.idProfissional

INNER JOIN Solicitacao so
    ON s.idServico = so.idServico

INNER JOIN Avaliacao a
    ON so.idSolicitacao = a.idSolicitacao

GROUP BY pr.idProfissional, u.nome;


-- CONSULTA 6:
-- Mostrar pagamentos aprovados

SELECT
    so.idSolicitacao,

    u.nome AS cliente,

    pg.valor,

    pg.formaPagamento,

    pg.statusPagamento

FROM Pagamento pg

INNER JOIN Solicitacao so
    ON pg.idSolicitacao = so.idSolicitacao

INNER JOIN Usuario u
    ON so.idCliente = u.idUsuario

WHERE pg.statusPagamento = 'APROVADO';


